# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Development and testing files
.helmignore
CLAUDE.md
README.md
docs/
examples/
tests/
*.test
*.log
# CI/CD files
.github/
.gitlab-ci.yml
Jenkinsfile
# Package manager files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*